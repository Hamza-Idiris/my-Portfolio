# Copy to .env.local for development, or configure in your host's dashboard.

# Base URL of the API. Leave empty in development to use the Vite dev proxy.
VITE_API_URL=

# Where the Vite dev server proxies /api and /uploads.
VITE_DEV_API_PROXY=http://127.0.0.1:5050

# Public URL of this site, used for canonical URLs and social metadata.
VITE_SITE_URL=http://localhost:5180
