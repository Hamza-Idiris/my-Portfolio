# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5050

# Local MongoDB for development. Swap for a MongoDB Atlas SRV string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/hamza_portfolio

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=hi_session
# Set to true when the API and frontend are on different domains (needs HTTPS).
CROSS_SITE_COOKIES=false
# COOKIE_DOMAIN=.example.com

# Comma separated list of allowed browser origins.
CLIENT_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Public URL of the frontend, used in emails, sitemap and canonical URLs.
SITE_URL=http://localhost:5180

# Enable when the app runs behind a proxy (Render, Railway, Nginx) so rate
# limiting sees the real client IP.
TRUST_PROXY=false

# --- File storage -----------------------------------------------------------
# local     -> writes to ./uploads (development only, lost on redeploy)
# cloudinary -> requires the credentials below
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hamza-portfolio

# --- Email ------------------------------------------------------------------
# console (default, logs instead of sending) | resend | smtp
EMAIL_DRIVER=console
EMAIL_API_KEY=
EMAIL_FROM=Hamza Idiris <onboarding@resend.dev>
EMAIL_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Seeding (development only) --------------------------------------------
SEED_ADMIN_USERNAME=hamza
SEED_ADMIN_EMAIL=admin@example.com
# Leave blank to have the seed script generate and print a temporary password.
SEED_ADMIN_PASSWORD=

ANALYTICS_ENABLED=true
